# Copy to `.env` (which is gitignored) and fill in your keys.
# Voxa auto-loads `.env` on startup; real environment variables take precedence.

# LLM translation backends (only the one you use is required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# OpenRouter — one key, many vendors (DeepSeek, Gemini, Llama…); use --translator openrouter
OPENROUTER_API_KEY=sk-or-...

# Self-hosted speech (--tts openai): an OpenAI-compatible server you run. OPENAI_API_KEY is
# never sent to it; set OPENAI_TTS_API_KEY only if the server wants a key of its own.
# OPENAI_TTS_BASE_URL=http://127.0.0.1:3900/v1
# OPENAI_TTS_API_KEY=
