# Keep the build context small: the image needs the engine, its metadata and the console's
# source, nothing else.
.git
.github
.venv
venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
build
dist

# The console is built from web/ in its own stage; its build output, dependencies and the
# landing page's media are not part of it.
web/node_modules
web/.next
web/out
web/public/demo
web/public/tts-samples
voxa_ui/static

# Docs, tests and examples do not affect the installed package.
docs
examples
tests
scripts

# Local runtime artifacts and media.
.voxa_serve
**/*_work
**/*.mp4
**/*.mkv
**/*.mov
**/*.avi
**/*.wav
**/*.mp3
**/*.srt
voxa.log

# Secrets must never reach a layer.
**/.env*
**/*.key
**/*.pem
